---
import Navigation from "../components/Navigation.astro";
import Layout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
const path = Astro.url.pathname.replace(/\//g, "");
---

<Layout title="Projects">
    <Navigation active={path} />
    <div class="flex h-screen w-screen">
        <div
            class="m-auto flex w-full max-w-4xl flex-col justify-center space-y-10 bg-slate-800 p-5 pt-20 md:rounded-xl md:p-10 md:pt-10">
            <!-- Project 1 -->
            <div>
                <h1 class="text-2xl font-bold">Dystopia</h1>
                <p class="text-slate-300">
                    Dystopia is a personal Discord bot built with JavaScript and meant to be able to do many things,
                    from acting as a moderating bot to playing music. Currently under development.
                </p>
                <a href="https://github.com/Dramatopian/Dystopia" target="_blank" class="text-blue-400 hover:underline">
                    View on GitHub
                </a>
            </div>
            <div>
                <h1 class="text-2xl font-bold">
                    <a href="https://converter.dramatopian.com" target="_blank" class="text-blue-400 hover:underline">
                        Unit Converter
                    </a>
                </h1>
                <p class="text-slate-300">
                    Unit-Converter is a web tool built with JavaScript that allows you to quickly and easily convert
                    different units and currency. Try it here:
                    <a href="https://converter.dramatopian.com" target="_blank" class="text-blue-400 hover:underline">
                        converter.dramatopian.com
                    </a>.
                </p>
            </div>
        </div>
    </div>
</Layout>
