---
import Navigation from "../components/Navigation.astro";
import Layout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
const path = Astro.url.pathname.replace(/\//g, "");
---

<Layout title="Projects">
    <Navigation active={path} />
    <div class="flex h-screen w-screen">
        <div
            class="m-auto flex w-full max-w-4xl flex-col justify-center bg-slate-800 p-5 pt-20 md:rounded-xl md:p-10 md:pt-10">
            <h1>Dystopia</h1>
            <p>Dystopia is a personal Discord bot built with Javascript and meant to be able to do many things, from acting as a moderating bot to playing music. Currently under development.</p>
        </div>
    </div>
</Layout>
