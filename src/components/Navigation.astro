---
const { active } = Astro.props;
---

<nav class=`fixed top-0 z-50 w-screen bg-slate-900 font-semibold`>
    <div class="mx-auto flex w-full max-w-4xl flex-row items-center justify-between px-2 py-2 md:px-1">
        <a
            href="/"
            class=`${active === "" ? "bg-slate-700" : "text-slate-300 transition-colors hover:bg-slate-800/80"} rounded-md p-2`>
            Home
        </a>
        <ul class="flex items-center space-x-2">
            <li>
                <a
                    href="/about"
                    class=`${active === "about" ? "bg-slate-700" : "text-slate-300 transition-colors hover:bg-slate-800/80"} inline-flex rounded-md p-2`>
                    About
                </a>
            </li>
            <li>
                <a
                    href="/projects"
                    class=`${active === "projects" ? "bg-slate-700" : "text-slate-300 transition-colors hover:bg-slate-800/80"} inline-flex rounded-md p-2`>
                    Projects
                </a>
            </li>
        </ul>
    </div>
</nav>
